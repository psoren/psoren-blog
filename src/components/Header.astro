---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
const base = import.meta.env.BASE_URL;
---

<header>
	<nav>
		<h2><a href={base}>{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href={base}>Home</HeaderLink>
			<HeaderLink href={`${base}blog/`}>Blog</HeaderLink>
			<HeaderLink href={`${base}projects/`}>Projects</HeaderLink>
		</div>
		<div class="header-right">
			<button
				id="theme-toggle"
				type="button"
				class="theme-toggle"
				aria-label="Toggle dark mode"
				title="Toggle dark mode"
			>
				<svg class="theme-icon icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
					<circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
					<g stroke="currentColor" stroke-width="2" stroke-linecap="round">
						<line x1="12" y1="2" x2="12" y2="5"></line>
						<line x1="12" y1="19" x2="12" y2="22"></line>
						<line x1="2" y1="12" x2="5" y2="12"></line>
						<line x1="19" y1="12" x2="22" y2="12"></line>
						<line x1="4.2" y1="4.2" x2="6.3" y2="6.3"></line>
						<line x1="17.7" y1="17.7" x2="19.8" y2="19.8"></line>
						<line x1="4.2" y1="19.8" x2="6.3" y2="17.7"></line>
						<line x1="17.7" y1="6.3" x2="19.8" y2="4.2"></line>
					</g>
				</svg>
				<svg class="theme-icon icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
					<path
						fill="currentColor"
						d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"
					></path>
				</svg>
			</button>
			<a class="gh" href="https://github.com/psoren" target="_blank" rel="me noopener noreferrer">
				<span class="sr-only">GitHub: psoren</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--bg-elevated);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 10%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.header-right {
		display: flex;
		align-items: center;
		gap: 0.6em;
	}
	.header-right .gh {
		display: inline-flex;
		color: rgb(var(--gray-dark));
	}
	.header-right .gh:hover {
		color: var(--accent);
	}
	.theme-toggle {
		background: transparent;
		border: 1px solid rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
		border-radius: 999px;
		width: 34px;
		height: 34px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		padding: 0;
		transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
	}
	.theme-toggle:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	/* Show sun in dark mode (so the button suggests "switch to light"),
	   moon in light mode. Toggle by hiding the other. */
	.theme-icon {
		display: none;
	}
	:root:not(.dark) .icon-moon { display: block; }
	:root.dark       .icon-sun  { display: block; }

	@media (max-width: 720px) {
		.header-right .gh {
			display: none;
		}
	}
</style>
<script>
	(function () {
		const btn = document.getElementById('theme-toggle');
		if (!btn) return;
		btn.addEventListener('click', () => {
			const isDark = document.documentElement.classList.toggle('dark');
			try {
				localStorage.setItem('theme', isDark ? 'dark' : 'light');
			} catch (e) {}
		});
	})();
</script>
